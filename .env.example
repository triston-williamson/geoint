# Copy this file to .env and fill in your values. .env is git-ignored.

# NASA FIRMS key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Optional. Without it the app uses FIRMS' open 24h/48h/7d files instead.
FIRMS_MAP_KEY=your_key_here

# How long (seconds) to cache each feed in memory
CACHE_TTL_SECONDS=600

# Overpass API endpoint for OpenStreetMap infrastructure queries
OVERPASS_URL=https://overpass-api.de/api/interpreter
